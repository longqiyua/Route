# ============================================================
# .gitignore.example — Reference template for Route
# ============================================================
# This file is a REFERENCE ONLY. It is tracked in git.
# The actual .gitignore is tracked; use this file as a recovery/reference copy.
#
# To use: copy this to .gitignore and customize:
#   cp .gitignore.example .gitignore
#
# IMPORTANT: .gitignore is in .gitignore itself and is NOT
# pushed to remote. This protects sensitive ignore rules.
# ============================================================

# === Build artifacts ===
node_modules/
dist/
target/
/Release/
**/target/
crates/*/target/
crates/*/web/dist/
*.rs.bk
.tauri/
**/gen/schemas/
*.tsbuildinfo
.vite/

# === Route internal data ===
.route/
.route-basic/
*.log

# === OS files ===
.DS_Store
Thumbs.db

# === Environment ===
.env
.env.*

# === IDE / Editor ===
.trae/
.vibe/
.ts/
.vscode/
.idea/

# === Debug artifacts ===
/_*.png
/_*.ps1
/_*.jpg
.dbg/

# === Demo / sandbox ===
sandbox-demo/
demo/

# === Python ===
.venv/
__pycache__/
*.pyc
*.pyd
*.pdb

# === Yuich runtime state (generated by CLI/dogfood; not source artifacts) ===
yuich/state/

# === Independent local repositories / reference packs ===
ppam/
PPAM/
/PPL/
crates/route-ppam/
ISM/*
!ISM/README.private.md
!ISM/.gitignore

# === Downloaded datasets ===
/Wiki/**/zhwiki-*-pages-articles-multistream.xml

# === Archived GUI ===
packages/desktop/dist/
packages/desktop/src-tauri/target/

# === Design docs ===
FrontDesignSkill.md
